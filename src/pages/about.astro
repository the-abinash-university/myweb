---
import SiteLayout from '../layouts/SiteLayout.astro';
import { site } from '../data/site';
import { Content } from '../content/about.md';

const linkedin = site.socialLinks.find(({ label }) => label === 'LinkedIn');
const github = site.socialLinks.find(({ label }) => label === 'GitHub');
const substack = site.socialLinks.find(({ label }) => label === 'Substack');
const profileImages = Object.entries(
  import.meta.glob<string>('../assets/profile/*.{avif,gif,jpg,jpeg,png,svg,webp}', {
    eager: true,
    query: '?url',
    import: 'default',
  }),
).sort(([firstPath], [secondPath]) => {
  const firstIsPlaceholder = firstPath.endsWith('/profile-placeholder.svg');
  const secondIsPlaceholder = secondPath.endsWith('/profile-placeholder.svg');

  if (firstIsPlaceholder !== secondIsPlaceholder) {
    return firstIsPlaceholder ? 1 : -1;
  }

  return firstPath.localeCompare(secondPath);
});
const profileImage = profileImages[0];

if (!profileImage) {
  throw new Error('Add a profile image or profile-placeholder.svg to src/assets/profile/.');
}

const [profileImagePath, profileImageUrl] = profileImage;
const isPhotoPlaceholder = profileImagePath.endsWith('/profile-placeholder.svg');
---

<SiteLayout title="About" description={`Highlights, leadership, engineering tools, and experience from ${site.name}, Power Systems Engineer.`}>
  <section class="page-intro">
    <p class="eyebrow">HIGHLIGHTS</p>
    <h1>About <span>me.</span></h1>
  </section>

  <section class="about-copy">
    <figure class="about-photo">
      <img
        src={profileImageUrl}
        alt={isPhotoPlaceholder ? 'Illustrated placeholder for Abinash Chaudhary’s profile photo' : 'Portrait of Abinash Chaudhary'}
        width="480"
        height="600"
      />
      <figcaption>
        {isPhotoPlaceholder
          ? <>Photo placeholder · add an image to <code>src/assets/profile/</code></>
          : 'Abinash Chaudhary · Power Systems Engineer'}
      </figcaption>
    </figure>
  </section>

  <article id="highlights" class="prose about-prose">
    <Content />
  </article>

  <section class="about-links" aria-label="Connect and explore">
    <p>Explore my <a href="/side-projects/">side projects</a>, <a href="/tutorials/">tutorials</a>, <a href="/blog/">writing</a>, and <a href="/publications/">publications</a>, or connect with me{linkedin && <> on <a href={linkedin.href}>LinkedIn</a></>}{linkedin && github && ' and'}{github && <> on <a href={github.href}>GitHub</a></>}{substack && <> or <a href={substack.href}>Substack</a></>}.</p>
  </section>

  <section class="resume-panel">
    <div>
      <p class="eyebrow">THE SHORT VERSION</p>
      <h2>Curriculum vitae</h2>
      <p>View or download my sample power systems engineering CV. The sample clearly marks details that need replacing with verified experience.</p>
    </div>
    <a class="button button-outline" href="/cv/">View CV <span aria-hidden="true">↗</span></a>
  </section>
</SiteLayout>
