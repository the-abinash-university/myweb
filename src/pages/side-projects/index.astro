---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PowerSystemArt from '../../components/PowerSystemArt.astro';

interface ProjectFrontmatter {
  title: string;
  description: string;
  tags?: string[];
}

const projects = Object.entries(
  import.meta.glob<{ frontmatter: ProjectFrontmatter }>('./*.md', { eager: true }),
)
  .map(([path, project]) => ({
    ...project,
    href: path.replace('./', '/side-projects/').replace(/\.md$/, ''),
  }));
---

<SiteLayout
  title="Power Systems Side Projects"
  description="Power systems and software side projects by Abinash Chaudhary, exploring utility engineering, grid analysis, and open-source tools."
>
  <section class="page-intro">
    <p class="eyebrow">ENGINEERING IDEAS &amp; EXPERIMENTS</p>
    <h1>Side <span>projects.</span></h1>
    <p class="page-lede">Here, I share the details about projects that interests me.</p>
    <div class="page-intro-art"><PowerSystemArt variant="battery" /></div>
  </section>

  <section class="content-section project-index">
    <div class="project-grid">
      {projects.map((project, index) => (
        <a class="project-card" href={project.href}>
          <span class="project-number">0{index + 1}</span>
          <h3>{project.frontmatter.title}<span aria-hidden="true"> ↗</span></h3>
          <p>{project.frontmatter.description}</p>
          <ul class="tag-list">
            {project.frontmatter.tags?.map((tag) => <li>{tag}</li>)}
          </ul>
        </a>
      ))}
    </div>
  </section>
  </SiteLayout>
