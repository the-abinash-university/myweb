---
import SiteLayout from '../layouts/SiteLayout.astro';
import PowerSystemArt from '../components/PowerSystemArt.astro';

interface PostFrontmatter {
  title: string;
  pubDate: string | Date;
  description: string;
  tags?: string[];
}

const posts = Object.entries(
  import.meta.glob<{ frontmatter: PostFrontmatter }>('./posts/*.md', { eager: true }),
)
  .map(([path, post]) => ({
    ...post,
    url: path.replace('./posts/', '/posts/').replace(/\.md$/, ''),
  }))
  .sort((a, b) => new Date(b.frontmatter.pubDate).valueOf() - new Date(a.frontmatter.pubDate).valueOf());
---

<SiteLayout
  title="Power Systems Articles & Writing"
  description="Power systems engineering articles on EMT studies, electrical utilities, grid planning, and open-source tools by Abinash Chaudhary."
>
  <section class="page-intro">
    <p class="eyebrow">THOUGHTS & NOTES</p>
    <h1>Writings. <span>Blogs. Thoughts. </span></h1>
    <p class="page-lede">Things that are not project or tutorial. A lot of me and my thoughts.</p>
    <div class="page-intro-art"><PowerSystemArt variant="wind" /></div>
  </section>

  <section class="post-list" aria-label="Blog posts">
    {posts.length > 0 ? posts.map((post) => (
      <a class="post-row" href={post.url}>
        <time datetime={new Date(post.frontmatter.pubDate).toISOString()}>
          {new Date(post.frontmatter.pubDate).toLocaleDateString('en', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
        </time>
        <div class="post-details">
          <h2>{post.frontmatter.title}</h2>
          <p>{post.frontmatter.description}</p>
          {(post.frontmatter.tags?.length ?? 0) > 0 && (
            <ul class="tag-list">
              {(post.frontmatter.tags ?? []).map((tag: string) => <li>{tag}</li>)}
            </ul>
          )}
        </div>
        <span class="post-arrow" aria-hidden="true">↗</span>
      </a>
    )) : (
      <div class="empty-card blog-empty">
        <span class="empty-mark" aria-hidden="true">✳</span>
        <div>
          <h2>The first note is still in the notebook.</h2>
          <p>New writing will show up here. Check back soon.</p>
        </div>
      </div>
    )}
  </section>
</SiteLayout>
