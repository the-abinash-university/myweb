---
import SiteLayout from '../layouts/SiteLayout.astro';
import { site } from '../data/site';

const heroImages = Object.entries(
  import.meta.glob<string>('../assets/hero/*.{avif,gif,jpg,jpeg,png,svg,webp}', {
    eager: true,
    query: '?url',
    import: 'default',
  }),
).sort(([firstPath], [secondPath]) => firstPath.localeCompare(secondPath));
const heroImage = heroImages[0]?.[1];

interface TutorialFrontmatter {
  title: string;
  pubDate: string | Date;
  description: string;
  tags?: string[];
}

const allTutorials = Object.entries(
  import.meta.glob<{ frontmatter: TutorialFrontmatter }>('./tutorials/*.md', { eager: true }),
)
  .map(([path, tutorial]) => ({
    ...tutorial,
    href: path.replace('./tutorials/', '/tutorials/').replace(/\.md$/, ''),
  }))
  .sort((a, b) => new Date(b.frontmatter.pubDate).valueOf() - new Date(a.frontmatter.pubDate).valueOf());
const tutorials = allTutorials.slice(0, 3);

interface ProjectFrontmatter {
  title: string;
  description: string;
  tags?: string[];
}

const allProjects = Object.entries(
  import.meta.glob<{ frontmatter: ProjectFrontmatter }>('./side-projects/*.md', { eager: true }),
)
  .map(([path, project]) => ({
    ...project,
    href: path.replace('./side-projects/', '/side-projects/').replace(/\.md$/, ''),
  }));
const projects = allProjects.slice(0, 3);

interface PublicationFrontmatter {
  title: string;
  description: string;
}

const allPublications = Object.entries(
  import.meta.glob<{ frontmatter: PublicationFrontmatter }>('./publications/*.md', { eager: true }),
)
  .map(([path, publication]) => ({
    ...publication,
    href: path.replace('./publications/', '/publications/').replace(/\.md$/, ''),
  }))
  .sort((a, b) => a.frontmatter.title.localeCompare(b.frontmatter.title));
const publications = allPublications.slice(0, 3);

interface PostFrontmatter {
  title: string;
  pubDate: string | Date;
  description: string;
  tags?: string[];
}

const allPosts = Object.entries(
  import.meta.glob<{ frontmatter: PostFrontmatter }>('./posts/*.md', { eager: true }),
)
  .map(([path, post]) => ({
    ...post,
    href: path.replace('./posts/', '/posts/').replace(/\.md$/, ''),
  }))
  .sort((a, b) => new Date(b.frontmatter.pubDate).valueOf() - new Date(a.frontmatter.pubDate).valueOf());
const posts = allPosts.slice(0, 3);
---

<SiteLayout title={site.title} description={site.description}>
  <section class="hero">
    <p class="eyebrow"><span class="status-dot"></span> MY LITTLE INTERNET SPACE</p>
    <h1><span>Modelling, Studies</span> &amp; Thoughts.</h1>
    <p class="hero-copy">{site.introduction}</p>
    <div class="hero-actions">
      <a class="button button-primary" href="#projects">Explore my work <span aria-hidden="true">↓</span></a>
      <a class="text-link" href="/about/">Learn more about me <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="/blog/">Read my writing <span aria-hidden="true">↗</span></a>
    </div>
    <nav class="hero-socials" aria-label="Social profiles">
      {site.socialLinks.map(({ label, href }) => (
        <a href={href} target="_blank" rel="noopener noreferrer">{label}<span aria-hidden="true"> ↗</span></a>
      ))}
    </nav>
    <div class="hero-stamp" aria-hidden="true">
      {heroImage ? (
        <img src={heroImage} alt="" width="480" height="600" />
      ) : (
        <svg viewBox="0 0 120 120" fill="none">
          <circle cx="83" cy="37" r="12" fill="var(--status)" stroke="none" />
          <path d="M14 78 43 43l15 18 11-13 37 30v8H14v-8Z" fill="var(--soft-green)" />
          <path d="m14 78 29-35 15 18m0 0 11-13 37 30" />
          <path d="m34 54 9-11 8 10-7-2-4 6m20 2 8-9 8 8-7-2-4 5" />
          <path d="M13 81c11-3 20 3 31 0s20-3 31 0 20 3 32 0" />
          <path d="M16 91c9-3 17 3 26 0s17-3 26 0 17 3 26 0 12-2 18 0" />
          <path d="M27 101c8-2 14 2 22 0s14-2 22 0 14 2 22 0" />
          <path d="M14 109h92" />
          <path d="M25 34c4-4 8-4 12 0m9-9c3-3 6-3 9 0" />
        </svg>
      )}
    </div>
  </section>

  <section class="content-section" id="projects">
    <div class="section-heading">
      <div>
        <p class="eyebrow">FUN &amp; ENGINEERING</p>
        <h2>Side projects</h2>
      </div>
      <a class="section-index section-action" href="/side-projects/">ALL PROJECTS ↗</a>
    </div>
    {projects.length > 0 ? (
      <div class="project-grid">
        {projects.map((project, index) => (
          <a class="project-card" href={project.href}>
            <span class="project-number">0{index + 1}</span>
            <h3>{project.frontmatter.title}<span aria-hidden="true"> ↗</span></h3>
            <p>{project.frontmatter.description}</p>
            <ul class="tag-list">
              {project.frontmatter.tags?.map((tag) => <li>{tag}</li>)}
            </ul>
          </a>
        ))}
        {allProjects.length > projects.length && (
          <a class="project-card project-more-card" href="/side-projects/">
            <span class="project-number">MORE ↗</span>
            <h3>More side projects</h3>
            <p>Explore all side projects.</p>
          </a>
        )}
      </div>
    ) : (
      <div class="empty-card">
        <span class="empty-mark" aria-hidden="true">✳</span>
        <div>
          <h3>Projects will take shape here.</h3>
          <p>Side projects and engineering notes will find a home here.</p>
        </div>
      </div>
    )}
  </section>

  <section class="content-section" id="publications">
    <div class="section-heading">
      <div>
        <p class="eyebrow">PAPERS &amp; PRESENTATIONS</p>
        <h2>Publications</h2>
      </div>
      <a class="section-index section-action" href="/publications/">ALL PUBLICATIONS ↗</a>
    </div>
    {publications.length > 0 ? (
      <>
        <div class="project-grid">
          {publications.map((publication, index) => (
            <a class="project-card" href={publication.href}>
              <span class="project-number">0{index + 1}</span>
              <h3>{publication.frontmatter.title}<span aria-hidden="true"> ↗</span></h3>
              <p>{publication.frontmatter.description}</p>
            </a>
          ))}
          {allPublications.length > publications.length && (
            <a class="project-card project-more-card" href="/publications/">
              <span class="project-number">MORE ↗</span>
              <h3>More publications</h3>
              <p>Browse all publications and presentations.</p>
            </a>
          )}
        </div>
        </>
    ) : (
      <div class="empty-card">
        <span class="empty-mark" aria-hidden="true">✳</span>
        <div>
          <h3>Publications are on their way.</h3>
          <p>Research and conference presentations will appear here.</p>
        </div>
      </div>
    )}
  </section>

  <section class="content-section" id="tutorials">
    <div class="section-heading">
      <div>
        <p class="eyebrow">LEARN BY WORKING THROUGH EXAMPLES</p>
        <h2>Tutorials</h2>
      </div>
      <a class="section-index section-action" href="/tutorials/">ALL TUTORIALS ↗</a>
    </div>
    {tutorials.length > 0 ? (
      <div class="project-grid">
        {tutorials.map((tutorial, index) => (
          <a class="project-card" href={tutorial.href}>
            <time class="project-number" datetime={new Date(tutorial.frontmatter.pubDate).toISOString()}>
              {new Date(tutorial.frontmatter.pubDate).toLocaleDateString('en', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
            </time>
            <h3>{tutorial.frontmatter.title}<span aria-hidden="true"> ↗</span></h3>
            <p>{tutorial.frontmatter.description}</p>
            {(tutorial.frontmatter.tags?.length ?? 0) > 0 && (
              <ul class="tag-list">
                {tutorial.frontmatter.tags?.map((tag) => <li>{tag}</li>)}
              </ul>
            )}
          </a>
        ))}
        {allTutorials.length > tutorials.length && (
          <a class="project-card project-more-card" href="/tutorials/">
            <span class="project-number">MORE ↗</span>
            <h3>More tutorials</h3>
            <p>Browse all tutorials and learning notes.</p>
          </a>
        )}
      </div>
    ) : (
      <div class="empty-card">
        <span class="empty-mark" aria-hidden="true">✳</span>
        <div>
          <h3>Tutorials are on their way.</h3>
          <p>Add Markdown tutorials to share practical notes and examples.</p>
        </div>
      </div>
    )}
  </section>

  <section class="content-section" id="writing">
    <div class="section-heading">
      <div>
        <p class="eyebrow">THOUGHTS, NOTES &amp; OCCASIONAL RABBIT HOLES</p>
        <h2>Writing</h2>
      </div>
      <a class="section-index section-action" href="/blog/">ALL WRITING ↗</a>
    </div>
    {posts.length > 0 ? (
      <div class="project-grid">
        {posts.map((post, index) => (
          <a class="project-card" href={post.href}>
            <time class="project-number" datetime={new Date(post.frontmatter.pubDate).toISOString()}>
              {new Date(post.frontmatter.pubDate).toLocaleDateString('en', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
            </time>
            <h3>{post.frontmatter.title}<span aria-hidden="true"> ↗</span></h3>
            <p>{post.frontmatter.description}</p>
          </a>
        ))}
        {allPosts.length > posts.length && (
          <a class="project-card project-more-card" href="/blog/">
            <span class="project-number">MORE ↗</span>
            <h3>More writing</h3>
            <p>Read all notes and articles.</p>
          </a>
        )}
      </div>
    ) : (
      <div class="empty-card">
        <span class="empty-mark" aria-hidden="true">✳</span>
        <div>
          <h3>Words in progress.</h3>
          <p>New writing will appear here.</p>
        </div>
      </div>
    )}
  </section>
</SiteLayout>
