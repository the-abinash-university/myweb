---
import type { MarkdownLayoutProps } from 'astro';
import SiteLayout from './SiteLayout.astro';

type Props = MarkdownLayoutProps<{
  title: string;
  description: string;
  noindex?: boolean;
}>;

const { frontmatter } = Astro.props;
---

<SiteLayout title={frontmatter.title} description={frontmatter.description} noindex={frontmatter.noindex}>
  <section class="page-intro cv-page-intro">
    <p class="eyebrow">SUMMARY TILL NOW</p>
    <h1>CV <span>&amp; experience.</span></h1>
  </section>

  <section class="cv-actions" aria-label="CV actions">
    <p class="cv-wit">Feel free to reach out if you feel like collaborating!</p>
    <div class="cv-buttons">
      <a class="button button-outline" href="/about/#highlights">
        View highlights <span aria-hidden="true">↗</span>
      </a>
      <button class="button button-primary cv-share-button" type="button">
        Share <span aria-hidden="true">↗</span>
      </button>
      <button class="button button-outline cv-print-button" type="button">
        Print / Save as PDF <span aria-hidden="true">↗</span>
      </button>
    </div>
    <p class="cv-share-status" role="status" aria-live="polite"></p>
  </section>

  <section class="cv-preview-section" aria-label="CV preview">
    <article class="cv-sheet cv-prose">
      <slot />
      <p class="cv-sheet-note">ABINASH CHAUDHARY · HOMEPAGE: abinashchaudhary.com · <a href="/about/">HIGHLIGHTS</a></p>
    </article>
  </section>

  <script>
    import '../scripts/cv-print.js';
    import '../scripts/cv-share.js';
  </script>
</SiteLayout>
