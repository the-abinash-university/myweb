---
import type { MarkdownLayoutProps } from 'astro';
import { site } from '../data/site';
import SiteLayout from './SiteLayout.astro';
import PowerSystemArt from '../components/PowerSystemArt.astro';

type Props = MarkdownLayoutProps<{
  title: string;
  pubDate: string | Date;
  description: string;
  tags?: string[];
  noindex?: boolean;
}>;

const { frontmatter } = Astro.props;
const { title, pubDate, description, tags = [], noindex = false } = frontmatter;
const date = new Date(pubDate);
const articleUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  author: { '@type': 'Person', name: site.name, url: 'https://abinashchaudhary.com/' },
  ...(articleUrl && { mainEntityOfPage: articleUrl }),
  ...(tags.length > 0 && { keywords: tags.join(', ') }),
};
---

<SiteLayout title={title} description={description} noindex={noindex} openGraphType="article">
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(articleStructuredData).replace(/</g, '\\u003c')}
  />
  <article class="post-article">
    <header class="post-header">
      <a class="post-back-link" href="/blog/">← All writing</a>
      <p class="eyebrow">NOTES & IDEAS</p>
      <h1>{title}</h1>
      <p class="post-description">{description}</p>
      <div class="post-header-art"><PowerSystemArt variant="solar" /></div>
      <time datetime={date.toISOString()}>
        {date.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
      </time>
      {tags.length > 0 && (
        <ul class="tag-list">
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</SiteLayout>
