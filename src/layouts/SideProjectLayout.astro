---
import type { MarkdownLayoutProps } from 'astro';
import SiteLayout from './SiteLayout.astro';

type Props = MarkdownLayoutProps<{
  title: string;
  description: string;
  tags?: string[];
}>;

const { frontmatter } = Astro.props;
const { title, description, tags = [] } = frontmatter;
---

<SiteLayout title={title} description={description}>
  <article class="post-article">
    <header class="post-header">
      <a class="post-back-link" href="/side-projects/">← All side projects</a>
      <p class="eyebrow">SIDE PROJECT · DONE WITHIN MY OWN TIME</p>
      <h1>{title}</h1>
      <p class="post-description">{description}</p>
      {tags.length > 0 && (
        <ul class="tag-list">
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</SiteLayout>
