---
import type { MarkdownLayoutProps } from 'astro';
import SiteLayout from './SiteLayout.astro';

type Props = MarkdownLayoutProps<{
  title: string;
  description: string;
  publicationUrl?: string;
}>;

const { frontmatter } = Astro.props;
---

<SiteLayout title={frontmatter.title} description={frontmatter.description}>
  <article class="post-article">
    <header class="post-header">
      <a class="post-back-link" href="/publications/">← All publications</a>
      <p class="eyebrow">PUBLICATION</p>
      <h1>{frontmatter.title}</h1>
      <p class="post-description">{frontmatter.description}</p>
      {frontmatter.publicationUrl && (
        <p><a href={frontmatter.publicationUrl} target="_blank" rel="noopener noreferrer">View publication ↗</a></p>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</SiteLayout>
