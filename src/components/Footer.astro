---
import { site } from '../data/site';
---
<footer class="site-footer">
  <span>&copy; {new Date().getFullYear()} {site.name}</span>
  <span class="footer-credit">Made with <a href="https://astro.build/">Astro</a>.</span>
  <nav class="footer-links" aria-label="Homepage, contact, and social links">
    <a href="/">Home</a>
    {site.email && <a href={`mailto:${site.email}`}>Email</a>}
    {site.socialLinks.map(({ label, href }) => <a href={href}>{label}</a>)}
  </nav>
</footer>