---
import Navigation from './Navigation.astro';
import { site } from '../data/site';
---
<header class="site-header">
  <a class="wordmark" href="/" aria-label={`${site.name} home`}>{site.name}<span>.</span></a>
  <Navigation currentPath={Astro.url.pathname} />
  <details class="mobile-navigation">
    <summary aria-label="Toggle main navigation">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </summary>
    <Navigation currentPath={Astro.url.pathname} mobile />
  </details>
  <button
    class="theme-toggle"
    type="button"
    aria-label="Dark mode"
    aria-pressed="false"
    title="Switch to dark mode"
  >
    <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
    </svg>
    <svg class="theme-icon theme-icon-stars" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 2.8 13.3 8l5.2 1.3-5.2 1.3-1.3 5.2-1.3-5.2-5.2-1.3L10.7 8 12 2.8Z" />
      <path d="m19 14 .7 2.3L22 17l-2.3.7L19 20l-.7-2.3L16 17l2.3-.7L19 14ZM5 3l.5 1.5L7 5l-1.5.5L5 7l-.5-1.5L3 5l1.5-.5L5 3Z" />
    </svg>
  </button>
</header>