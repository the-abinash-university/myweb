
---
interface Props {
  currentPath: string;
  mobile?: boolean;
}

const { currentPath, mobile = false } = Astro.props;
const links = [
  { href: '/about/', label: 'About' },
  { href: '/side-projects/', label: 'Side projects' },
  { href: '/blog/', label: 'Writing' },
  { href: '/tutorials/', label: 'Tutorials' },
  { href: '/publications/', label: 'Publications' },
  { href: '/cv/', label: 'CV' },
];
---
<nav
  class:list={['nav-links', mobile && 'nav-links-mobile']}
  aria-label={mobile ? 'Mobile main navigation' : 'Main navigation'}
>
  {links.map(({ href, label }) => (
    <a href={href} aria-current={currentPath === href || currentPath.startsWith(href) ? 'page' : undefined}>{label}</a>
  ))}
</nav>